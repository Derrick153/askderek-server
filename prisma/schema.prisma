generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_graphql, pg_stat_statements, pgcrypto, postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

// ─── ENUMS ────────────────────────────────────────────────

enum Role {
  TENANT
  MANAGER
  ADMIN
}

enum Highlight {
  HighSpeedInternetAccess
  WasherDryer
  AirConditioning
  Heating
  SmokeFree
  CableReady
  SatelliteTV
  DoubleVanities
  TubShower
  Intercom
  SprinklerSystem
  RecentlyRenovated
  CloseToTransit
  GreatView
  QuietNeighborhood
  SecurityGuard
  Gated
  BackupGenerator
  BoreHole
}

enum Amenity {
  WasherDryer
  AirConditioning
  Dishwasher
  HighSpeedInternet
  HardwoodFloors
  WalkInClosets
  Microwave
  Refrigerator
  Pool
  Gym
  Parking
  PetsAllowed
  WiFi
  Generator
  WaterTank
  DSTV
  TiledFloors
  Balcony
  Furnished
  SemiFinished
}

enum PropertyType {
  Rooms
  SelfContained
  Chamber
  Apartment
  Villa
  Townhouse
  Cottage
  Tinyhouse
  Office
  Shop
  CompoundHouse
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
}

enum PropertyStatus {
  Pending
  Approved
  Rejected
}

enum VerificationStatus {
  Pending
  Approved
  Rejected
}

// ─── USER ─────────────────────────────────────────────────

model User {
  id              Int      @id @default(autoincrement())
  clerkId         String   @unique
  email           String   @unique
  name            String
  phoneNumber     String?
  role            Role     @default(TENANT)
  isActive        Boolean  @default(true)
  isPhoneVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manager   Manager?
  tenant    Tenant?
  auditLogs AuditLog[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
}

// ─── MANAGER ──────────────────────────────────────────────

model Manager {
  id         Int     @id @default(autoincrement())
  clerkId    String  @unique
  isVerified Boolean @default(false)
  userId     Int     @unique

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedProperties Property[]
  verification      LandlordVerification?

  @@index([clerkId])
}

// ─── TENANT ───────────────────────────────────────────────

model Tenant {
  id          Int     @id @default(autoincrement())
  clerkId     String  @unique
  phoneNumber String?
  userId      Int     @unique

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]     @relation("TenantProperties")
  favorites     Property[]     @relation("TenantFavorites")
  applications  Application[]
  leases        Lease[]
  propertyViews PropertyView[]

  @@index([clerkId])
}

// ─── PROPERTY ─────────────────────────────────────────────

model Property {
  id                Int            @id @default(autoincrement())
  name              String
  description       String
  pricePerMonth     Float
  securityDeposit   Float          @default(0)
  applicationFee    Float          @default(0)
  photoUrls         String[]
  amenities         Amenity[]
  highlights        Highlight[]
  isPetsAllowed     Boolean        @default(false)
  isParkingIncluded Boolean        @default(false)
  beds              Int
  baths             Float
  squareFeet        Int            @default(0)
  propertyType      PropertyType
  postedDate        DateTime       @default(now())
  status            PropertyStatus @default(Pending)
  averageRating     Float?         @default(0)
  numberOfReviews   Int?           @default(0)
  locationId        Int
  managerClerkId    String

  location     Location       @relation(fields: [locationId], references: [id])
  manager      Manager        @relation(fields: [managerClerkId], references: [clerkId])
  leases       Lease[]
  applications Application[]
  favoritedBy  Tenant[]       @relation("TenantFavorites")
  tenants      Tenant[]       @relation("TenantProperties")
  views        PropertyView[]
  reports      Report[]

  @@index([managerClerkId])
  @@index([locationId])
  @@index([propertyType])
  @@index([pricePerMonth])
  @@index([status])
  @@index([postedDate])
}

// ─── LOCATION ─────────────────────────────────────────────

model Location {
  id          Int                                   @id @default(autoincrement())
  address     String
  city        String
  state       String                                @default("Western")
  region      String?                                @default("Western Region")
  area        String?                                @default("")
  country     String                                @default("Ghana")
  postalCode  String                                @default("")
  coordinates Unsupported("geography(Point, 4326)")
  properties  Property[]

  @@index([city])
  @@index([region])
  @@index([area])
}

// ─── APPLICATION ──────────────────────────────────────────

model Application {
  id              Int               @id @default(autoincrement())
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(Pending)
  propertyId      Int
  tenantClerkId   String
  name            String
  email           String
  phoneNumber     String
  message         String?
  leaseId         Int?              @unique

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantClerkId], references: [clerkId])
  lease    Lease?   @relation(fields: [leaseId], references: [id])

  @@index([tenantClerkId])
  @@index([propertyId])
  @@index([status])
  @@index([applicationDate])
}

// ─── LEASE ────────────────────────────────────────────────

model Lease {
  id            Int      @id @default(autoincrement())
  startDate     DateTime
  endDate       DateTime
  rent          Float
  deposit       Float    @default(0)
  propertyId    Int
  tenantClerkId String
  createdAt     DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  tenant      Tenant       @relation(fields: [tenantClerkId], references: [clerkId])
  application Application?
  payments    Payment[]

  @@index([tenantClerkId])
  @@index([propertyId])
  @@index([startDate])
  @@index([endDate])
}

// ─── PAYMENT ──────────────────────────────────────────────

model Payment {
  id                Int           @id @default(autoincrement())
  amountDue         Float
  amountPaid        Float         @default(0)
  dueDate           DateTime
  paymentDate       DateTime?
  paymentStatus     PaymentStatus @default(Pending)
  leaseId           Int
  paystackReference String?       @unique
  createdAt         DateTime      @default(now())

  lease Lease @relation(fields: [leaseId], references: [id])

  @@index([leaseId])
  @@index([paymentStatus])
  @@index([dueDate])
  @@index([paystackReference])
}

// ─── PROPERTY VIEW ────────────────────────────────────────

model PropertyView {
  id            String   @id @default(cuid())
  tenantClerkId String
  propertyId    Int
  viewedAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantClerkId], references: [clerkId], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantClerkId])
  @@index([propertyId])
  @@index([viewedAt])
  @@map("property_views")
}

// ─── LANDLORD VERIFICATION ────────────────────────────────

model LandlordVerification {
  id                Int                @id @default(autoincrement())
  managerClerkId    String             @unique
  ghanaCardFrontUrl String
  ghanaCardBackUrl  String
  phoneNumber       String
  status            VerificationStatus @default(Pending)
  rejectionReason   String?
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId Int?

  manager Manager @relation(fields: [managerClerkId], references: [clerkId])

  @@index([status])
  @@index([managerClerkId])
}

// ─── BLACKLIST ────────────────────────────────────────────

model Blacklist {
  id          Int      @id @default(autoincrement())
  phoneNumber String?
  email       String?
  ghanaCardId String?
  reason      String
  createdAt   DateTime @default(now())
  createdBy   Int

  @@index([phoneNumber])
  @@index([email])
  @@index([ghanaCardId])
}

// ─── REPORT ───────────────────────────────────────────────

model Report {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  reportedBy  String
  reason      String
  description String?
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  Int?

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([isResolved])
  @@index([createdAt])
}

// ─── AUDIT LOG ────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

// ─── OTP ──────────────────────────────────────────────────

model OTP {
  id        String   @id @default(cuid())
  clerkId   String
  otp       String
  phone     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clerkId])
  @@index([expiresAt])
}